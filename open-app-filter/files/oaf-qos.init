#!/bin/sh /etc/rc.common

START=98
USE_PROCD=1

start_service() {
    [ -x /usr/bin/oaf-qos-manager ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/oaf-qos-manager
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

stop_service() {
    /usr/bin/oaf-qos.sh clear >/dev/null 2>&1 || true
    [ -w /proc/oaf_qos_rules ] && printf 'clear\n' > /proc/oaf_qos_rules 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "appqos"
}
